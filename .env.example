# Copy to .env and fill in what you need. Everything here is optional.

# Public URL of the deployed site, without a trailing slash. Used for the
# canonical link, Open Graph image URL and sitemap.xml.
# Example: VITE_SITE_URL=https://your-domain.com
VITE_SITE_URL=

# Sub-path the site is served from. Leave empty for a root domain.
# GitHub Pages project site example: VITE_BASE_PATH=/portfolio/
VITE_BASE_PATH=

# Form endpoint for the contact form (Formspree, Web3Forms, Getform...).
# It receives a JSON POST of { name, email, message }.
# If empty, the form opens the visitor's email app with the message pre-filled.
# Example: VITE_CONTACT_ENDPOINT=https://formspree.io/f/abcdwxyz
VITE_CONTACT_ENDPOINT=
